# Example environment variables for running the backend locally
# Copy this to backend/.env and edit values as needed

# Use SQLite by default (creates reviews.db next to backend/)
DATABASE_URL=sqlite:///reviews.db

# Optional: MediaCloud API key for fetching collections/sources and publishing
# If not set, MediaCloud-dependent endpoints will fail, but the app can still run
MEDIACLOUD_API_KEY=

# ---------------------------------------------------------------------------
# REQUIRED FOR ANY REAL DEPLOYMENT
# ---------------------------------------------------------------------------
# Flask session/CSRF signing key.
#
# WARNING: if this is unset, config.py does NOT fail — it silently falls back to
# the hardcoded default 'dev-secret-key-change-in-production'. That value is in
# the repo and therefore public, so anyone can forge a session cookie against a
# deployment that never set this. Leaving it unset looks like a working app.
#
# Set it to a long random value in every non-local environment, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# SECRET_KEY=

# ---------------------------------------------------------------------------
# Optional MediaCloud settings (defaults shown; all safe to leave unset locally)
# ---------------------------------------------------------------------------
# Base URL used to build MediaCloud web links in the UI/API responses.
# MEDIACLOUD_SEARCH_BASE_URL=https://search.mediacloud.org

# Alternate base URL for MediaCloud *write* operations, e.g. pointing publish at
# a staging/dev MediaCloud API instead of production. Unset = use the default API.
# MEDIACLOUD_UPLOAD_BASE_URL=

# Master switch for publishing back to MediaCloud. Defaults to enabled, so set
# this to false in any environment that must not write to MediaCloud.
# Accepted truthy values: 1, true, yes, y
# MEDIACLOUD_PUBLISH_ENABLED=true

# When false, publish ignores apply_metadata_updates_to_existing_sources unless a
# request opts in explicitly. Defaults to enabled.
# MEDIACLOUD_PUBLISH_METADATA_UPDATES_ENABLED=true

# Optional flags
FLASK_DEBUG=True
